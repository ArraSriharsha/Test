# Copy to .env — never commit real secrets.

DATABASE_URL=postgresql+psycopg://USER@localhost:5432/dentnaav
SECRET_KEY=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Questionnaire: use S3 in production, or local file for dev (leave bucket empty).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_QUESTIONNAIRE_BUCKET=
S3_QUESTIONNAIRE_KEY=questionnaires/current.json
QUESTIONNAIRE_LOCAL_PATH=
QUESTIONNAIRE_CACHE_TTL_SECONDS=60

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
KNOWLEDGE_BASE_PATH=

LOG_LEVEL=INFO
